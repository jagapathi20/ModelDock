# Copy to .env and edit. Every variable is optional; defaults match docker-compose.yml.
MODELDOCK_ENV=dev
MODELDOCK_LOG_LEVEL=INFO

MODELDOCK_API_HOST=0.0.0.0
MODELDOCK_API_PORT=8000

MODELDOCK_REDIS_URL=redis://localhost:6379/0
MODELDOCK_POSTGRES_DSN=postgresql+asyncpg://modeldock:modeldock@localhost:5432/modeldock

MODELDOCK_S3_ENDPOINT_URL=http://localhost:9000
MODELDOCK_S3_ACCESS_KEY=minioadmin
MODELDOCK_S3_SECRET_KEY=minioadmin
MODELDOCK_S3_BUCKET=models
MODELDOCK_S3_REGION=us-east-1
