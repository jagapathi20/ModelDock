# Copy to .env and edit. Every variable is optional; defaults match docker-compose.yml.
MODELDOCK_ENV=dev
MODELDOCK_LOG_LEVEL=INFO

MODELDOCK_API_HOST=0.0.0.0
MODELDOCK_API_PORT=8000

MODELDOCK_REDIS_URL=redis://localhost:6379/0

# Request timeout: sets each request's deadline and the API's 504 timer (C1.16)
MODELDOCK_REQUEST_TIMEOUT_MS=500
# Bodies larger than this get 413 before parsing (C2.2)
MODELDOCK_MAX_BODY_BYTES=16384

# Worker: which catalog entry (common/models.py) to serve, and where model dirs live
MODELDOCK_WORKER_MODEL=sentiment
MODELDOCK_WORKER_VERSION=1
MODELDOCK_WORKER_THREADS=4
MODELDOCK_ARTIFACTS_DIR=artifacts
